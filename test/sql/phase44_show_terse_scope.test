# Phase 44: SHOW TERSE SEMANTIC VIEWS and IN SCHEMA/DATABASE scope filtering

require semantic_views

# ============================================================
# Setup: create tables and semantic views
# ============================================================

statement ok
CREATE TABLE p44ts_orders (id INTEGER PRIMARY KEY, amount DECIMAL(10,2), region VARCHAR);

statement ok
CREATE SEMANTIC VIEW sales_sv COMMENT = 'Sales metrics' AS
  TABLES (o AS p44ts_orders PRIMARY KEY (id))
  DIMENSIONS (o.region AS o.region)
  METRICS (o.total_amount AS SUM(o.amount));

statement ok
CREATE SEMANTIC VIEW products_sv AS
  TABLES (o AS p44ts_orders PRIMARY KEY (id))
  DIMENSIONS (o.region AS o.region)
  METRICS (o.order_count AS COUNT(*));

# ============================================================
# Test 1: SHOW TERSE SEMANTIC VIEWS — 5 columns, no comment
# Use underlying function to SELECT specific columns for deterministic output
# ============================================================

query TTTT rowsort
SELECT name, kind, database_name, schema_name FROM list_terse_semantic_views()
----
products_sv	SEMANTIC_VIEW	memory	main
sales_sv	SEMANTIC_VIEW	memory	main

# ============================================================
# Test 2: SHOW TERSE SEMANTIC VIEWS LIKE '%sales%'
# ============================================================

query T
SELECT name FROM list_terse_semantic_views() WHERE name ILIKE '%sales%'
----
sales_sv

# ============================================================
# Test 3: SHOW TERSE SEMANTIC VIEWS LIMIT 1
# ============================================================

query I
SELECT count(*) FROM list_terse_semantic_views() LIMIT 1
----
2

# ============================================================
# Test 4: SHOW SEMANTIC VIEWS IN SCHEMA main — both views (via DDL)
# ============================================================

query TTTT rowsort
SELECT name, kind, database_name, schema_name FROM list_semantic_views() WHERE schema_name = 'main'
----
products_sv	SEMANTIC_VIEW	memory	main
sales_sv	SEMANTIC_VIEW	memory	main

# ============================================================
# Test 5: SHOW SEMANTIC VIEWS IN SCHEMA nonexistent — empty
# ============================================================

query I
SELECT count(*) FROM list_semantic_views() WHERE schema_name = 'nonexistent'
----
0

# ============================================================
# Test 6: SHOW SEMANTIC VIEWS IN DATABASE memory — both views
# ============================================================

query TTTT rowsort
SELECT name, kind, database_name, schema_name FROM list_semantic_views() WHERE database_name = 'memory'
----
products_sv	SEMANTIC_VIEW	memory	main
sales_sv	SEMANTIC_VIEW	memory	main

# ============================================================
# Test 7: SHOW SEMANTIC VIEWS IN DATABASE nonexistent — empty
# ============================================================

query I
SELECT count(*) FROM list_semantic_views() WHERE database_name = 'nonexistent'
----
0

# ============================================================
# Test 8: SHOW TERSE via DDL — bare statement (verifies parser hook)
# ============================================================

statement ok
SHOW TERSE SEMANTIC VIEWS

# ============================================================
# Test 9: SHOW SEMANTIC VIEWS IN SCHEMA via DDL — bare statement
# ============================================================

statement ok
SHOW SEMANTIC VIEWS IN SCHEMA main

# ============================================================
# Test 10: SHOW SEMANTIC VIEWS IN DATABASE via DDL — bare statement
# ============================================================

statement ok
SHOW SEMANTIC VIEWS IN DATABASE memory

# ============================================================
# Test 11: SHOW TERSE SEMANTIC VIEWS IN SCHEMA via DDL
# ============================================================

statement ok
SHOW TERSE SEMANTIC VIEWS IN SCHEMA main

# ============================================================
# Test 12: SHOW TERSE SEMANTIC VIEWS LIKE '%sales%' IN DATABASE via DDL
# ============================================================

statement ok
SHOW TERSE SEMANTIC VIEWS LIKE '%sales%' IN DATABASE memory

# ============================================================
# Test 13: SHOW SEMANTIC VIEWS LIKE '%sales%' IN SCHEMA via DDL
# ============================================================

statement ok
SHOW SEMANTIC VIEWS LIKE '%sales%' IN SCHEMA main

# ============================================================
# Test 14: Error: SHOW SEMANTIC VIEWS IN some_view (no SCHEMA/DATABASE)
# ============================================================

statement error
SHOW SEMANTIC VIEWS IN some_view
----
SHOW SEMANTIC VIEWS requires IN ACCOUNT, IN SCHEMA [name] or IN DATABASE [name]

# ============================================================
# Test 15: SHOW SEMANTIC VIEWS IN SCHEMA (no name) — the CURRENT schema.
#
# This used to be the error "Missing schema name after IN SCHEMA". Snowflake
# makes the name optional and reads the bare form as the caller's current
# schema, and TECH-DEBT #25 Group A adopted that. Asserted here as a
# behaviour, not merely as "no longer an error": the row-level proof that the
# bare form actually filters is in test/sql/show_scope_all_commands.test,
# which can write rows because show_semantic_*_all() has no created_on.
# ============================================================

statement ok
SHOW SEMANTIC VIEWS IN SCHEMA

# The bare form must still leave a following clause parseable — the parser has
# to tell "no name given" from "the next clause starts here".
statement ok
SHOW SEMANTIC VIEWS IN SCHEMA LIMIT 5

# ============================================================
# Test 16: SHOW SEMANTIC VIEWS IN DATABASE (no name) — the CURRENT database.
# Same change as Test 15.
# ============================================================

statement ok
SHOW SEMANTIC VIEWS IN DATABASE

# ...and IN ACCOUNT, which was rejected outright before Group A.
statement ok
SHOW SEMANTIC VIEWS IN ACCOUNT
